{
  "id": "overdew",
  "root": "/qa/source",
  "sources": [
    "package.json",
    "bun.lock",
    "tsconfig.json",
    "vite.config.ts",
    "index.tsx",
    "PRODUCT.md",
    "DESIGN.md",
    "src",
    "www"
  ],
  "adapter": "/quaz/projects/overdew/adapter.ts",
  "context": ["/app/PRODUCT.md", "/app/DESIGN.md"],
  "scenarios": ["empty", "typical", "busy"],
  "revision": "git",
  "fetch": true,
  "deployment": {
    "url": "https://overdew.app/api/version",
    "repository": "tedstonne/overdew"
  },
  "controller": {
    "tracker": {
      "url": "https://overdew.app",
      "board": "eduardosasso/overdew"
    },
    "mode": "auto",
    "parallel": 2,
    "intervalSeconds": 300
  }
}
